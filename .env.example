# LLM provider: gemini | openai
LLM_PROVIDER=gemini
# Free tiers limit requests per minute; leave empty for no client-side throttle.
LLM_MAX_REQUESTS_PER_MINUTE=8

# Gemini (key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/banking_support

# Backend: auto (LangGraph if the provider's API key is set, else mock) | langgraph | mock
SUPPORT_BACKEND=auto

# Application
APP_ENV=development
LOG_LEVEL=INFO
